[
    {
        "type": "readers.las",
        "filename": "placeholder_input.laz"
    },
    {
        "type": "filters.assign",
        "assignment": "Classification[:]=1"
    },
    {
        "type": "filters.outlier",
        "method": "statistical",
        "mean_k": 8,
        "multiplier": 3.0
    },
    {
        "type": "filters.range",
        "limits": "Classification![7:7]"
    },
    {
        "type": "filters.smrf",
        "scalar": 1.2,
        "slope": 0.2,
        "threshold": 0.45,
        "window": 18.0
    },
    {
        "type": "writers.las",
        "filename": "placeholder_output.laz",
        "compression": "laszip",
        "dataformat_id": 7,
        "a_srs": "EPSG:25830"
    }
]
